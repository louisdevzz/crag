# ==============================================================================
# Legal CRAG Multi-Provider Configuration
# ==============================================================================

# LLM Provider Selection: "groq" | "openai" | "openrouter" | "ollama"
LLM_PROVIDER=groq

# Model Name per Provider
# - Groq (Free Plan, 2026-09-11 catalog): "qwen/qwen3.8-27b" (khuyến nghị, reasoning+coding+tool use),
#   "openai/gpt-oss-120b" (heavy cloud), "qwen/qwen3.6-27b", "openai/gpt-oss-20b", "groq/compound" (agent),
#   hoặc "auto" (tự động fetch model free tốt nhất còn hoạt động).
#   Lưu ý: llama-3.1-8b-instant, llama-3.3-70b-versatile, qwen-2.5-32b, qwen-qwq-32b đã bị Groq
#   deprecate khỏi free/developer tier (07-08/2026); không dùng các model này nữa.
# - OpenAI: "gpt-4o-mini", "gpt-4o"
# - OpenRouter: "deepseek/deepseek-chat", "anthropic/claude-3.5-sonnet", "meta-llama/llama-3.3-70b-instruct"
# - Ollama: "qwen3.8:latest" (local fallback tương ứng), "qwen2.5:14b-instruct"
LLM_MODEL=qwen/qwen3.8-27b
LLM_TEMPERATURE=0.4

# Vision LLM Provider/Model for OCR scanned/image PDF pages (legal/preprocessor.py).
# Defaults to LLM_PROVIDER when unset. "qwen/qwen3.8-27b" is Groq's current
# natively-multimodal model (verified working for image transcription) — the
# old default "llama-3.2-11b-vision-preview" was decommissioned by Groq in 04/2025.
VISION_PROVIDER=groq
VISION_MODEL=qwen/qwen3.8-27b

# Ingestion Performance — concurrency knobs for the ingestion pipeline
# (ingestion/worker.py, legal/preprocessor.py). Increase either only if your
# Vision LLM / embedding provider can absorb more simultaneous requests
# without hitting rate limits; the two multiply (documents-in-parallel x
# pages-in-parallel-per-document) into the real ceiling on concurrent
# outbound requests during a folder upload of many scanned PDFs.
# INGESTION_WORKERS: how many documents ingest concurrently (default 3).
# OCR_CONCURRENCY: how many pages within ONE document's OCR stage transcribe
# concurrently via the Vision LLM (default 4) — the fix for "large scanned
# PDF takes forever": OCR page count no longer bottlenecks 1 page at a time.
INGESTION_WORKERS=3
OCR_CONCURRENCY=4

# API Keys
GROQ_API_KEY=gsk_your_groq_api_key_here
OPENAI_API_KEY=sk-your_openai_api_key_here
OPENROUTER_API_KEY=sk-or-your_openrouter_api_key_here

# TinyFish Search API (controlled_web_search tool — https://docs.tinyfish.ai/search-api)
TINYFISH_API_KEY=your_tinyfish_api_key_here

# Provider Endpoints
OLLAMA_BASE_URL=http://localhost:11434
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Embedding & Reranker
EMBEDDING_MODEL=BAAI/bge-m3
RERANKER_MODEL=BAAI/bge-reranker-v2-m3

# Thresholds
T_LOW=0.35
T_HIGH=0.70
INTERNAL_STRIP_MIN=0.40


# Storage & Persistence Paths (Defaults to ~/.crag/)
# CRAG_HOME=~/.crag
# DB_PATH=~/.crag/app.db
# CHROMA_DIR=~/.crag/chroma
# LangFuse Monitoring (Optional — traces every LLM call in the CRAG turn when set)
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com
