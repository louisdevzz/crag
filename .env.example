# ==============================================================================
# Legal CRAG Multi-Provider Configuration
# ==============================================================================

# LLM Provider Selection: "groq" | "openai" | "openrouter" | "ollama"
LLM_PROVIDER=groq

# Model Name per Provider
# - Groq: "llama-3.3-70b-versatile", "qwen-2.5-32b", "mixtral-8x7b-32768"
# - OpenAI: "gpt-4o-mini", "gpt-4o"
# - OpenRouter: "deepseek/deepseek-chat", "anthropic/claude-3.5-sonnet", "meta-llama/llama-3.3-70b-instruct"
# - Ollama: "qwen2.5:14b-instruct", "llama3.1:8b"
LLM_MODEL=llama-3.3-70b-versatile
LLM_TEMPERATURE=0.0

# API Keys
GROQ_API_KEY=gsk_your_groq_api_key_here
OPENAI_API_KEY=sk-your_openai_api_key_here
OPENROUTER_API_KEY=sk-or-your_openrouter_api_key_here

# Provider Endpoints
OLLAMA_BASE_URL=http://localhost:11434
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Embedding & Reranker
EMBEDDING_MODEL=BAAI/bge-m3
RERANKER_MODEL=BAAI/bge-reranker-v2-m3

# Thresholds
T_LOW=0.35
T_HIGH=0.70
INTERNAL_STRIP_MIN=0.40

# LangFuse Monitoring (Optional)
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
