# LLM Provider Configuration ("groq" | "openai" | "openrouter" | "ollama")
LLM_PROVIDER=groq
LLM_MODEL=qwen/qwen3.8-27b
LLM_TEMPERATURE=0.4

# Vision LLM Configuration for Scanned PDF OCR
VISION_PROVIDER=groq
VISION_MODEL=qwen/qwen3.8-27b

# model openrouter free qwen/qwen3.8-27b:free
# Ingestion Concurrency Settings
INGESTION_WORKERS=3
OCR_CONCURRENCY=4

# API Keys
GROQ_API_KEY=gsk_your_groq_api_key_here
OPENAI_API_KEY=sk-your_openai_api_key_here
OPENROUTER_API_KEY=sk-or-your_openrouter_api_key_here

# TinyFish Search API Key
TINYFISH_API_KEY=your_tinyfish_api_key_here

# Provider Base URLs
OLLAMA_BASE_URL=http://localhost:11434
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Embedding & Reranker Models
EMBEDDING_MODEL=BAAI/bge-m3
RERANKER_MODEL=BAAI/bge-reranker-v2-m3

# CRAG Decision Thresholds
T_LOW=0.35
T_HIGH=0.70
INTERNAL_STRIP_MIN=0.40

# Storage Paths (Optional)
# CRAG_HOME=~/.crag
# DB_PATH=~/.crag/app.db
# CHROMA_DIR=~/.crag/chroma

# LangFuse Monitoring (Optional)
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com
