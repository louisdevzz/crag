    classDef cApi fill:#FAF5FF,stroke:#805AD5,stroke-width:2px,color:#553C9A;
    classDef cMem fill:#FEFCBF,stroke:#D69E2E,stroke-width:2px,color:#744210;
    classDef cRouter fill:#ED8936,stroke:#C05621,stroke-width:2px,color:#FFFFFF;
    classDef cDb fill:#EDF2F7,stroke:#4A5568,stroke-width:2px,color:#2D3748;
    classDef cRetrieve fill:#EBF8FF,stroke:#3182CE,stroke-width:2px,color:#2B6CB0;
    classDef cEval fill:#DD6B20,stroke:#C05621,stroke-width:2px,color:#FFFFFF;
    classDef cCorrect fill:#C6F6D5,stroke:#38A169,stroke-width:2px,color:#22543D;
    classDef cAmb fill:#FEFCBF,stroke:#D69E2E,stroke-width:2px,color:#744210;
    classDef cInc fill:#FED7D7,stroke:#E53E3E,stroke-width:2px,color:#742A2A;
