%%{init: {'theme': 'default', 'themeVariables': {'background': '#FFFFFF', 'fontFamily': 'Times New Roman', 'fontSize': '18px'}}}%%
flowchart LR
    subgraph P1 ["PHẦN 1: TRUY HỒI LAI VÀ XẾP HẠNG LẠI CROSS-ENCODER"]
        direction TB
        Q_IN(["Truy vấn pháp lý từ Agent Node"]):::cStart
        Q_ROUTER{"Đích danh Điều cụ thể<br/>hay Danh mục văn bản?"}:::cDec
        EXACT["Exact Locator / Catalog<br/>Bóc tách trực tiếp từ SQLite"]:::cSpec
        
        subgraph HYBRID ["Truy hồi lai Kép"]
            direction LR
            DENSE["Chroma Dense (BGE-M3)<br/>Top-20 Ứng viên"]:::cDense
            BM25["BM25Okapi Lexical<br/>Top-20 Ứng viên"]:::cBM25
        end

        RRF["Hợp nhất RRF (k = 60)<br/>Lấy Top-20 ứng viên"]:::cFusion
        RERANK["Cross-Encoder Reranker<br/>Chuẩn hóa Sigmoid [0.0, 1.0]<br/>Lọc Top-5 ứng viên"]:::cRerank

        Q_IN --> Q_ROUTER
        Q_ROUTER -->|Có đích danh| EXACT
        Q_ROUTER -->|Truy vấn chung| HYBRID
        HYBRID --> RRF --> RERANK
    end

    subgraph P2 ["PHẦN 2: BỘ ĐÁNH GIÁ 3 NHÁNH VÀ TINH LỌC DẢI QUY ĐỊNH"]
        direction TB
        EVAL{"CRAG Evaluator<br/>Kiểm tra best_score"}:::cEval
        
        B_CORRECT["Nhánh CORRECT (>= 0.70)<br/>Bằng chứng nội bộ đầy đủ"]:::cOk
        B_AMB["Nhánh AMBIGUOUS (0.35 - 0.70)<br/>Bằng chứng đáp ứng một phần"]:::cWarn
        B_INC["Nhánh INCORRECT (<= 0.35)<br/>Thiếu hụt dữ liệu nội bộ"]:::cFail

        subgraph REFINE ["Cơ chế Tinh lọc Tri thức"]
            direction TB
            STRIPS["Bóc tách thành Legal Strips (Khoản/Điểm)"]:::cRef
            FILTER["Lọc ngưỡng tối thiểu >= 0.40"]:::cRef
            STRIPS --> FILTER
        end

        OUT_CORRECT(["Evidence nội bộ + Hướng dẫn: Trả lời trực tiếp"]):::cEndOk
        OUT_AMB(["Evidence nội bộ + Hướng dẫn: Gọi thêm Web Search"]):::cEndWarn
        OUT_INC(["Evidence rỗng + Hướng dẫn: Bắt buộc gọi Web Search"]):::cEndFail

        EVAL -->|Score >= 0.70| B_CORRECT --> REFINE --> OUT_CORRECT
        EVAL -->|0.35 < Score < 0.70| B_AMB --> REFINE --> OUT_AMB
        EVAL -->|Score <= 0.35| B_INC --> OUT_INC
        EXACT --> OUT_CORRECT
    end

    RERANK --> EVAL

