{
  "schema_version": 2,
  "diagram_type": "workflow",
  "meta": {
    "title": "Legal CRAG Agent — Router & Corrective Pipeline",
    "quality_profile": "showcase",
    "output": "legal-crag-agent-rendered.html"
  },
  "lanes": [
    { "id": "entry", "label": "User & Direct Routes" },
    { "id": "core", "label": "Retrieval & Evaluation" },
    { "id": "correction", "label": "Corrective Web Fallback", "variant": "exception" },
    { "id": "output", "label": "Generation & Verification" }
  ],
  "phases": [
    { "id": "route", "label": "Route", "fromCol": 0, "toCol": 0 },
    { "id": "crag", "label": "Corrective RAG", "fromCol": 1, "toCol": 2, "variant": "emphasis" },
    { "id": "verify", "label": "Generate + Verify", "fromCol": 3, "toCol": 4, "variant": "dashed" }
  ],
  "mainPath": ["router", "retrieve_evaluate", "refine", "generate_validate", "success"],
  "nodes": [
    { "id": "router", "lane": "entry", "col": 0, "type": "backend", "label": "Query Router", "sublabel": "LLM router", "width": 130 },
    { "id": "db", "lane": "entry", "col": 1, "type": "database", "label": "Direct Lookup", "sublabel": "metadata / greeting", "width": 130 },
    { "id": "direct_reply", "lane": "entry", "col": 2, "type": "external", "label": "Direct Reply", "sublabel": "skip grounding", "width": 130 },
    { "id": "retrieve_evaluate", "lane": "core", "col": 1, "type": "backend", "label": "Hybrid Retrieval", "sublabel": "retrieve + score", "width": 130 },
    { "id": "refine", "lane": "core", "col": 2, "type": "backend", "label": "Knowledge Refine", "sublabel": "strip decomposition", "width": 130 },
    { "id": "rewrite_web", "lane": "correction", "col": 2, "type": "cloud", "label": "Rewrite + Web", "sublabel": "vbpl.vn, chinhphu.vn", "tag": "AMBIGUOUS / INCORRECT", "width": 130 },
    { "id": "generate_validate", "lane": "output", "col": 3, "type": "backend", "label": "Generate + Validate", "sublabel": "JSON + citations", "width": 130 },
    { "id": "success", "lane": "output", "col": 4, "type": "external", "label": "Grounded Answer", "sublabel": "citations valid", "width": 130 },
    { "id": "fail", "lane": "correction", "col": 4, "type": "security", "label": "Abstain", "sublabel": "insufficient", "width": 130 }
  ],
  "edges": [
    { "id": "router-db", "from": "router", "to": "db", "label": "metadata / chào hỏi", "variant": "default" },
    { "id": "router-retrieve", "from": "router", "to": "retrieve_evaluate", "label": "nội dung pháp luật", "variant": "emphasis" },
    { "id": "db-direct", "from": "db", "to": "direct_reply", "variant": "default" },
    { "id": "retrieve-refine", "from": "retrieve_evaluate", "to": "refine", "label": "CORRECT / AMBIGUOUS", "variant": "emphasis" },
    { "id": "retrieve-rewrite", "from": "retrieve_evaluate", "to": "rewrite_web", "label": "INCORRECT (score < 0.35)", "variant": "security" },
    { "id": "refine-generate", "from": "refine", "to": "generate_validate", "label": "CORRECT", "variant": "emphasis" },
    { "id": "refine-rewrite", "from": "refine", "to": "rewrite_web", "label": "AMBIGUOUS (0.35–0.70)", "variant": "dashed" },
    { "id": "rewrite-merge-generate", "from": "rewrite_web", "to": "generate_validate", "label": "merge internal + external", "variant": "dashed" },
    { "id": "generate-success", "from": "generate_validate", "to": "success", "label": "citations valid", "variant": "emphasis" },
    { "id": "generate-fail", "from": "generate_validate", "to": "fail", "label": "invalid / expired", "variant": "security", "role": "error" }
  ],
  "cards": [
    {
      "dot": "cyan",
      "title": "Router decision (2026-09-14 fix)",
      "items": [
        "general → direct LLM reply, no evidence required, no abstain",
        "database → metadata/effective-date lookup, bypasses retrieval",
        "rag → full Corrective RAG pipeline with citations"
      ]
    },
    {
      "dot": "rose",
      "title": "Corrective thresholds (T_low=0.35, T_high=0.70)",
      "items": [
        "score ≥ T_high → CORRECT: internal strips only",
        "T_low ≤ score < T_high → AMBIGUOUS: internal + web merge",
        "score < T_low → INCORRECT: official web sources only"
      ]
    }
  ]
}
