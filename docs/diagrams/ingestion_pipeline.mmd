flowchart TD
    START_FILE(["Văn bản Pháp quy (PDF / DOCX / TXT)"]):::cStart --> UPLOAD["Upload API / CLI Ingestion<br/>Tạo bản ghi documents & jobs"]:::cStage
    UPLOAD --> BG_WORKER["Background Worker ThreadPool<br/>(INGESTION_WORKERS = 3)"]:::cStage

    subgraph ROW1 ["PHẦN 1: TIẾP NHẬN, OCR VÀ LÀM SẠCH VĂN BẢN THÔ"]
        direction LR
        S1["GĐ 1: PARSING<br/>PyMuPDF kiểm tra Text Layer<br/>Bóc tách trang văn bản"]:::cSub
        S2["GĐ 2: OCR SCAN<br/>Vision LLM Worker<br/>(Concurrency = 4)"]:::cOCR
        S3["GĐ 3: CLEANING<br/>Loại bỏ dot leaders, footers<br/>Chuẩn hóa Unicode NFC"]:::cClean
        S4["GĐ 4: STRUCTURING<br/>Phần -> Chương -> Mục<br/>-> Điều -> Khoản -> Điểm"]:::cStruct

        S1 -->|Trang ảnh scan| S2
        S1 -->|Đã có text layer| S3
        S2 --> S3
        S3 --> S4
    end

    BG_WORKER --> S1

    subgraph ROW2 ["PHẦN 2: PHÂN ĐOẠN PHÁP LÝ, NHÚNG VECTOR VÀ LẬP CHỈ MỤC KÉP"]
        direction LR
        S5["GĐ 5: CHUNKING<br/>Legal-aware Chunking<br/>Bảo toàn Điều & Header"]:::cChunk
        S6["GĐ 6: EMBEDDING<br/>Mô hình BGE-M3 (1024-d)<br/>Nhúng ngữ nghĩa ngầm"]:::cEmbed
        S7["GĐ 7: INDEXING<br/>ChromaDB (Dense Vector)<br/>BM25Okapi (Lexical Index)"]:::cIndex
        S8["GĐ 8: SẴN SÀNG<br/>status = READY trong SQLite<br/>Kích hoạt phục vụ CRAG"]:::cDone

        S5 --> S6
        S6 --> S7
        S7 --> S8
    end

    S4 -->|Chuyển tiếp văn bản có cấu trúc| S5
    S8 --> END_KB(["Kho Tri thức CRAG Hoàn tất"]):::cEnd

